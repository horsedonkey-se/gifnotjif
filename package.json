{
  "name": "gifnotjif",
  "version": "0.1.0",
  "private": true,
  "description": "Record a screen region and land an animated GIF on your clipboard.",
  "license": "GPL-3.0-or-later",
  "author": "Hargaaya Idris",
  "homepage": "https://github.com/horsedonkey-se/gifnotjif#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/horsedonkey-se/gifnotjif.git"
  },
  "bugs": {
    "url": "https://github.com/horsedonkey-se/gifnotjif/issues"
  },
  "keywords": [
    "gif",
    "screen-recorder",
    "screen-capture",
    "clipboard",
    "electron",
    "ffmpeg"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "dist/src/main/index.js",
  "scripts": {
    "build": "node scripts/copy-static.mjs && tsc",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "doctor": "npm run build && electron dist/scripts/doctor.js",
    "spike": "npm run build && node dist/scripts/spike.js",
    "dist": "npm run build && electron-builder --publish never",
    "release": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2"
  }
}
